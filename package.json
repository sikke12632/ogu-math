{
  "name": "ogu-math",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "check": "tsx scripts/validate.ts",
    "dump": "tsx scripts/dump.ts",
    "snapshot:save": "tsx scripts/snapshot.ts save",
    "snapshot:check": "tsx scripts/snapshot.ts check",
    "check:game": "tsx scripts/game-check.ts",
    "deploy": "npm run build && gh-pages -d dist --dotfiles",
    "check:scope": "tsx scripts/scope-check.ts"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
